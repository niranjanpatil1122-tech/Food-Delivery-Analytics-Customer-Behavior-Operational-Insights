      <aliases enabled='yes' />
      <column caption='Total Revenue' datatype='integer' name='[Calculation_1992622619656192]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_value])' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_1992622619783169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([order_value]) / COUNT([user_id])' />
      </column>
      <column caption='Repeat Orders' datatype='integer' name='[Calculation_1992622620434434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_repeat_order]&#13;&#10;    WHEN &apos;Yes&apos; THEN 1 &#13;&#10;    ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Non Repeat Orders' datatype='integer' name='[Calculation_1992622621167619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [is_repeat_order]&#13;&#10;    WHEN &apos;No&apos; THEN 1&#13;&#10;    ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Repeat Order %' datatype='real' default-format='p0.00%' name='[Calculation_1992622622085124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1992622620434434]) / COUNTD([order_id])' />
      </column>
      <column caption='Average Delivery Time' datatype='real' name='[Calculation_1992622623490053]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([time_taken_to_order])' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1992622633631752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([order_id])' />
      </column>
      <column caption='Weekday Volume' datatype='integer' name='[Calculation_1992622645469193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [day_type] = &apos;Weekday&apos; THEN [order_id] END)' />
      </column>
      <column caption='Weekend Volume' datatype='integer' name='[Calculation_1992622646050826]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [day_type] = &apos;Weekend&apos; THEN [order_id] END)' />
      </column>
